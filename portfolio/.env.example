# Copy this file to .env.local and fill in your real values.
# Groq API key -- get one free at https://console.groq.com (no card needed)
GROQ_API_KEY=

# Google OAuth -- from console.cloud.google.com (see setup steps I gave you)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Any random long string -- used to encrypt session tokens. You can generate
# one by running: openssl rand -base64 32   (or just mash the keyboard)
NEXTAUTH_SECRET=

# Must match where your app runs
NEXTAUTH_URL=http://localhost:3000

# Only this exact Google account email will be allowed into /admin
ADMIN_EMAIL=